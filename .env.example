# ===========================================
# SMTP Mail Configuration
# ===========================================
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=587
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# ===========================================
# Omise Payment Gateway
# ===========================================
OMISE_API_VERSION=2019-05-29
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
